# Application-hosted Teams media bots require a Windows Server guest in production.
FROM mcr.microsoft.com/dotnet/sdk:6.0-windowsservercore-ltsc2022 AS build
WORKDIR C:/src
COPY . .
RUN dotnet publish Empathy.TeamsAgent.csproj -c Release -o C:/out --no-self-contained

FROM mcr.microsoft.com/dotnet/aspnet:6.0-windowsservercore-ltsc2022
WORKDIR C:/app
COPY --from=build C:/out .
ENTRYPOINT ["dotnet", "Empathy.TeamsAgent.dll"]
